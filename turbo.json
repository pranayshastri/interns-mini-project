{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "prisma:generate": {
      "cache": false
    },
    "auth-service#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "outputs": [
        "dist/**",
        "generated/prisma/**"
      ]
    }
  },
  "globalEnv": [
    "API_GATEWAY_URL",
    "NEXT_DIST_DIR",
    "ROBONEST_AUTH_ENABLED",
    "ROBONEST_VERIFIED_CAPABILITIES",
    "CHROME_PATH"
  ]
}
