{
  "name": "mini-project-ecommerce",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dev:auth": "node scripts/dev-auth.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.17.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
