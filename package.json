{
  "name": "mini-project-ecommerce",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev-auth.cjs --all",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dev:auth": "node scripts/dev-auth.cjs",
    "test:commerce": "npm run build --workspace=auth-service --workspace=catalog-service --workspace=order-service --workspace=inventory-service --workspace=api-gateway && node --test apps/api-gateway/test/commerce.integration.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.17.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
