# =========================================================================
# DISTRIBUTED E-COMMERCE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================
# Copy this file to '.env' and adjust values for your local environment:
#   cp .env.example .env

# --- POSTGRESQL (Multi-Database Setup) ---
POSTGRES_USER=ecommerce_admin
POSTGRES_PASSWORD=Sec_Pg98_Enterprise_K3mQ7wL2zR_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_MULTIPLE_DATABASES=ecommerce_auth_db,ecommerce_catalog_db,ecommerce_order_db,ecommerce_inventory_db

# Microservice Database URLs (Docker network)
AUTH_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/ecommerce_auth_db?sslmode=disable
CATALOG_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/ecommerce_catalog_db?sslmode=disable
ORDER_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/ecommerce_order_db?sslmode=disable
INVENTORY_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/ecommerce_inventory_db?sslmode=disable

# Microservice Database URLs (Host machine development e.g. npm run dev)
LOCAL_AUTH_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/ecommerce_auth_db?sslmode=disable
LOCAL_CATALOG_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/ecommerce_catalog_db?sslmode=disable
LOCAL_ORDER_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/ecommerce_order_db?sslmode=disable
LOCAL_INVENTORY_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/ecommerce_inventory_db?sslmode=disable

# --- VALKEY (High-Performance In-Memory Session & Cache) ---
VALKEY_HOST=valkey
VALKEY_PORT=6379

# --- APACHE KAFKA (KRaft Mode - No ZooKeeper) ---
KAFKA_BROKER_INTERNAL=kafka:9092
KAFKA_BROKER_HOST=localhost:9094
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_TOPIC_ORDERS=shop.orders.v1

# --- KAFKA UI ---
KAFKA_UI_PORT=8080

# --- EDGE API GATEWAY & MICROSERVICES PORTS ---
API_GATEWAY_PORT=4000
AUTH_SERVICE_PORT=50051
CATALOG_SERVICE_PORT=50052
ORDER_SERVICE_PORT=50053
INVENTORY_SERVICE_PORT=50054
FRONTEND_PORT=3000

# Service Addresses (Docker internal network)
AUTH_SERVICE_ADDR=auth-service:50051
CATALOG_SERVICE_ADDR=catalog-service:50052
ORDER_SERVICE_ADDR=order-service:50053
INVENTORY_SERVICE_ADDR=inventory-service:50054

# --- SECURITY & AUTHENTICATION ---
JWT_SECRET=c8f8b0e77d9f48529341b5e022d4f54e63778a48b94df8694086ad345c22bb1e
JWT_EXPIRATION=3600s

# --- ZERO-TRUST mTLS CERTIFICATE DIRECTORY ---
TLS_CERT_DIR=./infra/certs
