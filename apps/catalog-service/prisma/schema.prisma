// Prisma Schema for Catalog Service (Database: catalog_db)
// 
// ARCHITECTURE NOTE:
// Database-per-service pattern (ARCHITECTURE.md Section 7.1).
// Connects to PostgreSQL database: catalog_db.
// 
// TODO: [Intern Task - Catalog Model]
// 1. Configure datasource with provider = "postgresql" and env("DATABASE_URL").
// 2. Define Product model matching catalog_db DDL:
//    - id: UUID @id @default(uuid())
//    - shopId: UUID @map("shop_id")
//    - name: String
//    - description: String
//    - priceCents: BigInt @map("price_cents")
//    - createdAt: DateTime @default(now()) @map("created_at")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid())
  shopId      String   @map("shop_id")
  name        String
  description String
  priceCents  BigInt   @map("price_cents")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("products")
}
