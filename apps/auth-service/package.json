{
  "name": "auth-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "dev": "nest start --watch",
    "dev:local": "node scripts/start-local.cjs",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:mtls": "npm run test:integration",
    "test:integration": "npm run build && npm run build --workspace=api-gateway && node --test test/mtls.test.cjs",
    "test:browser": "AUTH_BROWSER_TEST=1 npm run test:integration",
    "account:provision": "node scripts/provision-account.cjs",
    "schema:profile": "node scripts/apply-profile-schema.cjs",
    "schema:admin": "node scripts/apply-admin-schema.cjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.4.0",
    "@repo/proto": "*",
    "bcryptjs": "^2.4.3",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@repo/typescript-config": "*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "prisma": "^6.4.0",
    "typescript": "^5.7.3"
  }
}
