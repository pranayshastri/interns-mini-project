// Prisma Schema for Order Service (Database: ecommerce_order_db)
//
// ARCHITECTURE NOTE:
// Implements Transactional Outbox Pattern (ARCHITECTURE.md Section 4.3).
// Connects to PostgreSQL database: ecommerce_order_db.
//
// Invoice Model:
// - Persisted Prisma invoices linked to confirmed orders.
// - Invoice status mirrors the associated order status (PENDING -> CONFIRMED -> INVOICED -> PAID).
// - Each confirmed order has exactly one invoice, which is derived/created at CONFIRMED.
// - Invoice payload includes order summary, totals, and buyer/seller info.
// - Invoice model is read-only from the gateway; created via internal service.
//
// Invoice creation is performed transactionally when an order is confirmed.
//
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id               String      @id @default(uuid())
  customerId       String      @map("customer_id")
  totalAmountCents BigInt      @map("total_amount_cents")
  status           String      @default("PENDING")
  shippingAddress  String      @map("shipping_address")
  createdAt        DateTime    @default(now()) @map("created_at")
  items            OrderItem[]
  invoice          Invoice?

  @@map("orders")
}

model OrderItem {
  id             String  @id @default(uuid())
  orderId        String  @map("order_id")
  productId      String  @map("product_id")
  shopId         String  @map("shop_id")
  quantity       Int
  unitPriceCents BigInt  @map("unit_price_cents")
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  topic         String
  payload       Json
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model InventoryReservation {
  id            String  @id @default(uuid())
  productId     String  @map("product_id")
  shopId        String  @map("shop_id")
  orderId       String  @map("order_id")
  quantity      Int
  status        String  @default("PENDING") // 'PENDING', 'CONFIRMED', 'FAILED'
  reservedAt    DateTime @default(now()) @map("reserved_at")

  @@index([orderId, status])
  @@map("inventory_reservations")
}

model Invoice {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id") @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status     String   @default("PENDING") // PENDING, CONFIRMED, INVOICED, PAID, FAILED
  totalCents BigInt   @map("total_cents")
  buyerId    String   @map("buyer_id")
  sellerId   String   @map("seller_id")
  createdAt  DateTime @default(now()) @map("created_at")
  paidAt     DateTime? @map("paid_at")
  pdfUrl     String?  @map("pdf_url")
  metadata   Json     @default("{}")

  @@map("invoices")
}